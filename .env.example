# Local storefront configuration
NODE_ENV=development
PORT=4173
PAYMENT_BACKEND=sandbox
PAYMENT_ASSET=XRP
PAYMENT_MAX_AMOUNT=2
PAYMENT_SESSION_LIMIT=2

# USDC x402 challenge configuration. USDC_PAY_TO is mandatory in live
# AgentCore Payments mode and has no live fallback.
USDC_NETWORK=eip155:84532
USDC_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC_PAY_TO=

XRPL_NETWORK=xrpl:1
XRPL_HTTP_URL=
XRPL_MAX_FEE_DROPS=2000
XRPL_RECONCILIATION_INTERVAL_SECONDS=30

# Optional deployed-runtime configuration
AGENTCORE_RUNTIME_ARN=
AGENTCORE_RUNTIME_ENDPOINT_ARN=
AWS_REGION=us-east-1

# Live XRPL values are public identifiers. Never place a wallet seed here.
XRPL_MERCHANT_ADDRESS=
XRPL_WALLET_SEED_SECRET_ARN=
XRPL_RUNTIME_PAYER_ADDRESS=

# Optional AgentCore Payments identifiers
PAYMENT_MANAGER_ARN=
PAYMENT_SESSION_ID=
PAYMENT_INSTRUMENT_ID=
