{
  "name": "sample-agentcore-xrpl-guest-commerce",
  "version": "1.0.0",
  "private": true,
  "license": "MIT-0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "start": "bun run server.ts",
    "dev": "NODE_ENV=development bun --hot run server.ts",
    "test": "bun test --path-ignore-patterns='cdk.out/**' test/",
    "typecheck": "tsc --noEmit",
    "verify": "\"$npm_execpath\" run scripts/verify.ts",
    "cdk:synth:verify": "bun run infra/cdk/bin/verify-synth.ts",
    "cdk:synth": "cdk synth",
    "cdk:diff": "cdk diff",
    "cdk:deploy": "cdk deploy --all",
    "cdk:destroy": "cdk destroy --all"
  },
  "engines": {
    "bun": "1.4.4"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1148.0",
    "@aws-sdk/client-bedrock-agentcore-control": "^3.1148.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1148.0",
    "@aws-sdk/client-cloudfront": "^3.1148.0",
    "@aws-sdk/client-dynamodb": "^3.1148.0",
    "@aws-sdk/client-secrets-manager": "^3.1148.0",
    "@aws-sdk/lib-dynamodb": "^3.1148.0",
    "@x402/core": "2.28.0",
    "@x402/xrpl": "2.28.0",
    "aws4fetch": "1.0.20",
    "buffer": "^6.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ripple-keypairs": "^2.1.0",
    "xrpl": "^4.4.0"
  },
  "devDependencies": {
    "@aws-sdk/client-ec2": "^3.1149.0",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "aws-cdk": "^2.1146.1",
    "aws-cdk-lib": "2.274.0",
    "cdk-nag": "^3.0.2",
    "constructs": "10.8.1",
    "esbuild": "^0.28.2",
    "happy-dom": "21.0.4",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "zod": "4.6.6"
  }
}
