{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": [
    "server.ts",
    "packages/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "agent/**/*.ts",
    "infra/cdk/**/*.ts",
    "test/**/*.ts"
  ]
}
